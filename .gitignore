# ---- ROMs: never commit -------------------------------------------------
*.gb
*.gbc
*.sgb

# Save files
*.sav
*.srm
*.sav.bak*
*.state

# Curated tester-created SRAM regressions are intentionally versioned. Personal saves
# stay ignored everywhere else, and emulator machine states remain local/generated.
!tests/fixtures/saves/*.srm

# ---- Build output: all regenerable --------------------------------------
# build/ holds the base.gb symlink, patched ROMs and rendered PNGs. Every file
# in here is produced by the tools from the original ROM, so none of it belongs
# in history.
build/

# ---- Extracted script: regenerable AND derived from the game ------------
# script.json / script.tsv are the Japanese text pulled straight out of the ROM.
# They rebuild in seconds with:
#     python3 tools/extract.py build/base.gb
# so there is no reason to keep game content in the repo.
script/script.json
script/script.tsv

# ---- Python ------------------------------------------------------------
__pycache__/
*.pyc

# ---- macOS -------------------------------------------------------------
.DS_Store
